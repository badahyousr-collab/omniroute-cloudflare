{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omniroute-cloudflare",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "OmniRouteContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OMNIROUTE_CONTAINER",
        "class_name": "OmniRouteContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OmniRouteContainer"]
    }
  ]
}
